# ─── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ─── Database ──────────────────────────────────────────────────────────────
# Local MongoDB connection string. For production, provide a MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017/prepforge

# ─── Client / CORS ─────────────────────────────────────────────────────────
# Comma-separated exact browser origins. Production must include the deployed frontend origin.
CLIENT_ORIGIN=http://localhost:5173

# ─── Auth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-64-character-random-string-value
JWT_REFRESH_SECRET=replace-me-with-a-different-64-character-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# ─── Email ─────────────────────────────────────────────────────────────────
EMAIL_FROM=PrepForge <no-reply@prepforge.local>
# Set to false to actually send mail through SMTP (required in production).
EMAIL_LOG_ONLY=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
